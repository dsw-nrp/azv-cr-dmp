{%- set eu_doc = assets("static/European_Commission_Document.png") -%}
{%- set eu_flag = assets("static/Flag_of_Europe.png") -%}

<header>
  <center>
  <img src="{{ eu_doc.src_value }}" height="78" width="160" class="eu-header" />
  </center>
  <h1>{{data.meta.document.name}}</h1>
  <center>
  <img src="{{ eu_flag.src_value }}" height="213" width="320" class="eu-flag" />
  </center>
  <h3>
    Horizon Europe<br/>
    Data Management Plan
  </h3>

  <div class="info">
    <div class="version-info">
      {% for version in dc.project.versions if version.uuid == dc.project.version %}
        <div class="version">{{version.name}}</div>
      {% endfor %}
      <div class="date">{{ data.meta.document.createdAt|datetime_format("%d %B %Y") }}</div>
    </div>

    <p class="note">
      Data Management Plan created in {{ dc.config.service_name }} &laquo;<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_url }}</a>&raquo;<br/> using {{ dc.pkg.name }} v{{ dc.pkg.version }} (<span class="package-id"><span class="organization-id">{{ dc.pkg.org_id }}</span>:<span class="km-id">{{ dc.pkg.km_id }}</span>:<span class="version">{{ dc.pkg.version }}</span></span>).
    </p>
  </div>
</header>