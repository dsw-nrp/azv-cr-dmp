{%- set eu_header = assets("static/eu-header.png") -%}
{%- set eu_flag = assets("static/eu-flag.png") -%}
{%- set azv_cr_logo = assets("static/AZVCR_color.svg") -%}
<header>
  <center>
  <img src="{{ azv_cr_logo.data_url }}" width="90%" class="frontpage-img" />
  </center>
  <h1>{{ data.meta.document.name }}</h1>





  <div class="info">
    <h3>
    Data Management Plan
  </h3>


    <div class="version-info">
      {% for version in dc.project.versions if version.uuid == dc.project.version %}
        <div class="version">{{version.name}}</div>
      {% endfor %}
      <div class="date">{{ data.meta.document.createdAt|datetime_format("%d %B %Y") }}</div>
    </div>

    <p class="note">
        Data Management Plan created in {{ dc.config.service_name }} <a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_url }}</a>. Corresponds with Horizon Europe DMP template.
    </p>
  </div>
</header>
