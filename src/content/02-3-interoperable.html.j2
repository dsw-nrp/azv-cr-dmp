<div id="q-interoperable" class="question">
    <div class="answer">
    <p>This section describes how the project will ensure that data can be combined with other datasets, both within and across disciplines. It focuses on the use of shared formats, vocabularies, ontologies, and community standards to support interoperability.</p>
        {%- set formats = [] -%}
        {%- set newDataTypes = [] -%}
        {%- set usedOntologies = [] -%}
        {%- for dataset in data.dmp.datasets -%}
            {%- for distribution in dataset.distributions -%}
                {%- do formats.extend(distribution.formats) -%}
                {%- if distribution.newDataType -%}
                    {%- set _ = newDataTypes.append({'newDataType': distribution.newDataType, 'distributionName': distribution.name}) -%}
                {%- endif -%}
                {%- do usedOntologies.extend(distribution.usedOntologies) -%}
            {%- endfor -%}
        {%- endfor -%}
        {# Remove duplicates based on .name._value for formats and usedOntologies #}
        {%- set formats = formats | unique(attribute='name._value') | list -%}
        {%- set usedOntologies = usedOntologies | unique(attribute='name._value') | list -%}

        {# Formats and types #}
        {%- if formats|length > 0 -%}
        <div>We will be using the following data formats and types:
            <ul>
            {%- for format in formats -%}
            <li>
                {%- if format.name._url %} <em><a href="{{ format.name._url }}" target="_blank">{{format.name._value }}</a></em>
                {%- elif format.name._value %} <em>{{ format.name._value }}</em>
                {%- else -%}<em>(no name given)</em>{% endif %}
                <p>
                {# Well described? Standard?#}
                {%- if format.isDescribed._value or format.isStandard._value -%}
                    This format is
                    {%- if format.isDescribed._value is sameas true %}
                        well described
                    {%- elif format.isDescribed._value is sameas false %}
                        not well described
                    {%- endif -%}
                    {%- if format.isStandard._value is sameas true %}
                        standard format
                    {%- elif format.isStandard._value is sameas false %}
                        {%- if format.noStandardReason._value == "no_format" %}
                            non-standard format because there is no standardized format for this data type
                        {%- elif format.noStandardReason._value == "optimalization" %}
                            non-standard format but it is optimized for processing speed and/or volume
                        {%- elif format.noStandardReason and format.noStandardReason._value %}
                            non-standard format because {{ format.noStandardReason._value }}
                        {%- else %}
                            non-standard format
                        {%- endif %}
                    {%- endif -%}
                    .
                {%- endif -%}
                {# Suitable for long term? #}
                {%- if format.isSuitableForLongTerm._value is sameas true %}
                    It is suitable for long-term preservation.
                {%- elif format.isSuitableForLongTerm._value is sameas false %}
                    It is not suitable for long-term preservation
                    {# Convert to suitable for long term? #}
                    {%- if format.convertToLongTermSuitable._value is sameas true %}
                        and we will convert it to a format suitable for long-term preservation
                    {%- elif format.convertToLongTermSuitable._value is sameas false %}
                        but we will not convert it to a format suitable for long-term preservation
                    {%- endif -%}.
                {%- endif -%}
                </p>
            </li>
            {%- endfor -%}
            </ul>
        </div>
        {%- else -%}
        <div>We will not be using any specific data formats or types.</div>
        {%- endif -%}

        {# Used standards (ontologies, vocabularies, ..) #}
        {%- if usedOntologies|length > 0 -%}
        <div>We will be using the following standards (encodings, terminologies, vocabularies, ontologies):
            <ul>
            {%- for ontology in usedOntologies -%}
                <li>
                    <em>{{ ontology.name._value if ontology.name else "(no name given)" }}</em>{{ " - " ~ ontology.url._value if ontology.url else "" }}
                </li>
            {%- endfor -%}
            </ul>
        </div>
        {%- else -%}
        <div>We will not be using any specific standards (encodings, terminologies, vocabularies, ontologies).</div>
        {%- endif -%}

        {# New data types #}
        {%- if newDataTypes|length > 0 -%}
        <div>We will be using the following new types of data for listed distributions:
            <ul>
            {%- for newDataType in newDataTypes -%}
                <li>
                    <b>{{ newDataType.distributionName._value if newDataType.distributionName._value else "(no name given)" }}</b>
                    {%- set usesOntology = newDataType.newDataType.usesNewOntology._value -%}
                    {%- set providesMapping = newDataType.newDataType.providesOntologyMapping._value -%}
                    <p>
                    {# Ontology and mapping #}
                    {%- if usesOntology is sameas false %}
                        Although we will be using new types of data in this distribution, suitable public controlled vocabularies or ontologies exist for those.
                    {%- elif usesOntology is sameas true and providesMapping is sameas true %}
                        We will be using new types of data in this distribution. For that reason, we will make and publish a vocabulary or ontology for some of our data. Such terms will be mapped to existing vocabularies or ontologies.
                    {%- elif usesOntology is sameas true and providesMapping is sameas false %}
                        We will be using new types of data in this distribution. For that reason, we will make and publish a vocabulary or ontology for some of our data.
                    {%- endif -%}
                    {# Fields #}
                    {%- if newDataType.newDataType.needsAddFields._value == "no" %}
                        We will not need to add any new fields to the data, all of them are already descried in a data type registry.
                    {%- elif newDataType.newDataType.needsAddFields._value == "yes_existing_registry" %}
                        We will need to add new types to an existing data type registry.
                    {%- elif newDataType.newDataType.needsAddFields._value == "yes_own_registry" %}
                        We will need to add new types to data type registry, that we will create on our own.
                    {%- endif -%}
                    {# Creation process #}
                    {%- if newDataType.newDataType.creationProcess._value == "specification"%}
                        There is a closely related, more generic and open format that we can specialize for our needs.
                    {%- elif newDataType.newDataType.creationProcess._value == "linked_data_format" %}
                        There is a Linked Data Format that we can use to design our new data type.
                    {%- elif newDataType.newDataType.creationProcess._value == "custom" %}
                        We will create a completely new and custom data type format.
                    {%- endif -%}
                    {# Description for others #}
                    {%- if newDataType.newDataType.descriptionForOther._value is sameas true %}
                        We will provide a description of the new data type for others.
                    {%- endif -%}
                    {# Data type registries #}
                    {%- if newDataType.newDataType.dataTypeRegistry._value %}
                        We will use the following data type registries: {{ newDataType.newDataType.dataTypeRegistry._value }}.
                    {%- endif -%}
                    </p>
                </li>
            {%- endfor -%}
            </ul>
        </div>
        {%- else -%}
        <div>We will not be using any new types of data.</div>
        {%- endif -%}

        {# Qualified references #}
        {%- set has_qualified_references = false -%}
        {%- for dataset in data.dmp.datasets -%}
            {%- if dataset.qualifiedReferences|length > 0 -%}
            {%- set has_qualified_references = true -%}
            {%- endif -%}
        {%- endfor -%}
        {%- if has_qualified_references -%}
        <p>The following produced and published datasets will use qualified references:</p>
        <ul>
        {% for dataset in data.dmp.datasets %}
            {%- if dataset.qualifiedReferences|length > 0 -%}
            <li><strong>{{ dataset.name._value if dataset.name._value else "<em>(no name given)</em>" }}</strong>
            <ul>
            {%- for reference in dataset.qualifiedReferences -%}
                <li><em>{{ reference.identifier._value if reference.identifier._value else "<em>(no identifier given)</em>" }}</em> &ndash; {{ reference.relationship._value if reference.relationship._value else "<em>(no relationship given)</em>" }}</li>
            {%- endfor -%}
            </ul>
            </li>
            {% endif %}
        {% endfor %}
        </ul>
        {%- endif -%}
    </div>
</div>
