<div id="q-findable" class="question">
  <div class="answer">
    {# Produced datasets #}
    {%- if data.dmp.datasets|length > 0 -%}
        <p>This section focuses on how data will be made discoverable, including the use of persistent identifiers, metadata standards, and mechanisms for indexing and keywords.</p>
        {%- for dataset in data.dmp.datasets -%}
            <h4>
                {%- if dataset.name -%}
                <strong>{{ macros.integrationValue(dataset.name) }}</strong>
                {%- else -%}
                    <strong>(no name given)</strong>
                {%- endif -%}
                {# If will be published #}
                {%- if dataset.isPublished._value is sameas true %} (published)
                {%- elif dataset.isPublished._value is sameas false %} (not published)
                {%- endif -%}:
            </h4>
            {# Identifiers #}
            {%- if dataset.metadata -%}
                {%- if dataset.metadata.usesPids._value is sameas true -%}
                    {%- if dataset.metadata.whoProvidesPids._value == "project" -%}
                        <p>A persistent identifier (PID) for this dataset will be assigned by the project’s data steward or principal investigator.</p>
                    {%- elif dataset.metadata.whoProvidesPids._value == "institutional" -%}
                        <p>A persistent identifier (PID) for this dataset will be assigned by the institutional data steward.</p>
                    {%- elif dataset.metadata.whoProvidesPids._value == "repository" -%}
                        <p>A persistent identifier (PID) for this dataset will be assigned automatically by the data repository upon submission.</p>
                    {%- elif dataset.metadata.whoProvidesPids._value == "provider" -%}
                        <p>A persistent identifier (PID) for this dataset will be assigned by the national or international PID service provider.</p>
                    {%- elif dataset.metadata.whoProvidesPids._value -%}
                        <p>A persistent identifier (PID) for this dataset will be assigned by {{ dataset.metadata.whoProvidesPids._value }}.</p>
                    {%- endif -%}
                {%- elif dataset.metadata.usesPids._value is sameas false -%}
                    <p>A persistent identifier (PID) for this dataset will not be assigned.</p>
                {%- endif -%}
            {%- endif -%}
            {%- if dataset.identifiers|length > 0 %}
                <p>The dataset has the following identifiers:
                <ul>
                    {%- for identifier in dataset.identifiers -%}
                            <li><em>{{identifier.type._value}}: {{ identifier.value._value }}</em></li>
                    {%- endfor -%}
                </ul>
                </p>
            {%- endif -%}

            {# Organisations - versions, file names #}
            {%- if dataset.organisationStrategy -%}
                <p>
                {# Relationships between files #}
                {% if dataset.organisationStrategy.fileNamingConvention.isRelationshipsBetweenFiles._value is sameas true %}
                    We will keep the relationships between data clear in the file names.
                {% endif %}
                {% if dataset.organisationStrategy.fileNamingConvention.isMetadataEmbedded._value is sameas true %}
                    All metadata elements embedded in file names will also be included in the formal metadata to ensure completeness and consistency.
                {% elif dataset.organisationStrategy.fileNamingConvention.isMetadataEmbedded._value is sameas false %}
                    Metadata embedded in file names will not necessarily be included in the formal metadata.
                {% endif %}

                {# Uses folder system  #}
                {% if dataset.organisationStrategy.usesFolderSystem._value is sameas true %}
                    We will use a folder system to organize the data{% if dataset.organisationStrategy.folderSystemStrategy._value %}: {{ dataset.organisationStrategy.folderSystemStrategy._value }}.{% else %}, but no specific folder system strategy has been provided.{% endif %}
                {% endif %}

                {# Agreement on file naming convention #}
                {% if dataset.organisationStrategy.fileNamingConvention.isAgreementOnFileNamingConvention._value is sameas true %}
                    A project-wide agreement on file naming conventions and versioning for this dataset is in place
                    {% if dataset.organisationStrategy.fileNamingConvention.agreementOnFileNamingConvention %}
                         ({{dataset.organisationStrategy.fileNamingConvention.agreementOnFileNamingConvention._value}})
                    {% else %}, but no specific convention has been provided{% endif %}.
                {% elif dataset.organisationStrategy.fileNamingConvention.isAgreementOnFileNamingConvention._value is sameas false %}
                    No project-wide agreement on file naming conventions and versioning is in place.
                {% endif %}
                <p>

                {# Versions #}
                {%- if dataset.organisationStrategy.dataStorageSystemOrganisations|length > 0 -%}
                    <p>
                    Updates and versioning of this dataset are managed according to the following strategy:
                    <ul>
                    {%- for dataStorageSystemOrganisation in dataset.organisationStrategy.dataStorageSystemOrganisations -%}
                        {%- if dataStorageSystemOrganisation.storageSystem and dataStorageSystemOrganisation.versioningStrategy -%}
                        <li>
                            {{ dataStorageSystemOrganisation.storageSystem._label if dataStorageSystemOrganisation.storageSystem and dataStorageSystemOrganisation.storageSystem._label else dataStorageSystemOrganisation.storageSystem._value if dataStorageSystemOrganisation.storageSystem else '' }} ~ {{ dataStorageSystemOrganisation.versioningStrategy._label if dataStorageSystemOrganisation.versioningStrategy and dataStorageSystemOrganisation.versioningStrategy._label else dataStorageSystemOrganisation.versioningStrategy._value if dataStorageSystemOrganisation.versioningStrategy else '' }}
                        </li>
                        {%- endif -%}
                    {%- endfor -%}
                    </ul>
                    </p>
                {%- endif -%}
            {%- endif -%}

            {# Metadata #}
            {%- if dataset.metadata -%}
                {# Metadata Standards #}
                <p>
                {%- if dataset.metadata.isStandardMetadata._value is sameas true %}
                    This dataset uses a standard metadata schema that allows the metadata to be harvested and indexed
                    {%- if dataset.metadata.standardMetadata.type._label == "url" and dataset.metadata.standardMetadata.identifier._value %} (<a href="{{ dataset.metadata.standardMetadata.identifier._value }}" target="_blank">{{ dataset.metadata.standardMetadata.identifier._value }}</a>)
                    {%- elif dataset.metadata.standardMetadata.type._label == "other" and dataset.metadata.standardMetadata.identifier._value %} (Identifier</strong>: {{dataset.metadata.standardMetadata.identifier._value }})
                    {%- endif -%}.

                {%- elif dataset.metadata.isStandardMetadata._value is sameas false -%}
                    This dataset does not use a standard metadata schema{% if dataset.metadata.noStandardMetadata.reason._value == "no_standard" %} because there are no standards in this project area{%- elif dataset.metadata.noStandardMetadata.reason._value %} because: {{ dataset.metadata.noStandardMetadata.reason._value }}{% endif %}.
                    {%- if dataset.metadata.noStandardMetadata.description._value %}
                        We will use a non-standard metadata schema described as follows: {{ dataset.metadata.noStandardMetadata.description._value }}
                    {%- endif -%}
                    {%- if dataset.metadata.noStandardMetadata.metadataElements|length > 0 %}
                        Metadata elements that will be used in the non-standard metadata schema:
                        <ul>
                            {%- for element in dataset.metadata.noStandardMetadata.metadataElements -%}
                                <li>{{ element._value }}</li>
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}
                    {%- if dataset.metadata.noStandardMetadata.canBeHarvestedIndexed._value is sameas true-%}
                        The metadata will be captured in a way that allows them to be harvested and indexed.
                    {%- endif -%}
                {%- endif -%}

                {%- if dataset.metadata.isFindable._value is sameas true %}
                    The metadata will be findable.
                {%- elif dataset.metadata.isFindable._value is sameas false %}
                    The metadata will not be findable{% if dataset.metadata.noFindableReason._value %} because: {{ dataset.metadata.noFindableReason._value }}{% endif %}.
                {%- endif -%}

                {%- if dataset.metadata.howConnectionToData._value %}
                    The connection between the metadata and the data will be ensured as follows: {{ dataset.metadata.howConnectionToData._value }}.
                {%- endif -%}
                </p>
            {%- endif -%}

            {# Keywords #}
            {%- if dataset.keywords|length > 0 -%}
                <p>We will include keywords and relevant ontology references to optimise the possibility for discovery and potential reuse. We will use the following keywords: {{ dataset.keywords| map(attribute='_value') | join(', ') }}.</p>
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
  </div>
</div>
