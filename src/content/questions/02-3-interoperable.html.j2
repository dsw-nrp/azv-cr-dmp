<div id="q-interoperable" class="question">
    <div class="answer">
    <p>This section describes how the project will ensure that data can be combined with other datasets, both within and across disciplines. It focuses on the use of shared formats, vocabularies, ontologies, and community standards to support interoperability.</p>
        {%- set formats = [] -%}
        {%- set newDataTypes = [] -%}
        {%- set usedOntologies = [] -%}
        {%- for dataset in data.dmp.datasets -%}
            {%- for distribution in dataset.distributions -%}
                {# Collect formats #}
                {%- if distribution.formats -%}
                    {%- for format in distribution.formats -%}
                        {%- if format.name and format.name._raw -%}
                            {%- set tmpFormat = format -%}
                            {%- do tmpFormat.name.update({
                                    '_value': format.name._raw.name,
                                    '_path': format.name._path,
                                    '_raw': format.name._raw
                            }) -%}
                            {%- do formats.append(tmpFormat) -%}
                        {%- else -%}
                            {%- do formats.append(format) -%}
                        {%- endif -%}
                    {%- endfor -%}
                {%- endif -%}
                {%- if distribution.newDataType -%}
                    {%- set _ = newDataTypes.append({'newDataType': distribution.newDataType, 'distributionName': distribution.name}) -%}
                {%- endif -%}
                {%- for usedOntology in distribution.usedOntologies -%}
                    {%- if usedOntology.name and usedOntology.name._raw -%}
                        {%- set tmpOntology = {} -%}
                        {%- do tmpOntology.update({
                            'name': {
                                '_value': usedOntology.name._raw.name,
                                '_path': usedOntology.name._path,
                                '_raw': usedOntology.name._raw
                            },
                            'url': {
                                '_value': usedOntology.name._raw.homepage,
                                '_path': usedOntology.name._path,
                                '_raw': usedOntology.name._raw
                            }
                        }) -%}
                        {%- do usedOntologies.append(tmpOntology) -%}
                    {%- else -%}
                        {%- do usedOntologies.append(usedOntology) -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endfor -%}
        {%- endfor -%}
        {# Remove duplicates based on .name._value for formats and usedOntologies #}
        {%- set formats = formats | unique(attribute='name._value') | list -%}
        {%- set usedOntologies = usedOntologies | unique(attribute='name._value') | list -%}
        

        {# Formats and types #}
        {%- if formats|length > 0 -%}
        <div>We will be using the following data formats and types:
            <ul>
            {%- for format in formats -%}
            <li>
                {%- if format.name -%}
                    {%- if format.name._raw -%} <em><a href="https://fairsharing.org/{{ format.name._raw.id }}" target="_blank">{{format.name._raw.name }}</a></em>{{ macros.linkQuestion(format.name._path) }}
                    {%- elif format.name._value %} <em>{{ format.name._value }}</em>{{ macros.linkQuestion(format.name._path) }}
                    {%- endif -%}    
                {%- else %} <em>(no name given)</em>
                {%- endif -%}
                <p>
                {# Well described? Standard?#}
                {%- if format.isDescribed or format.isStandard -%}
                    This format is a
                    {%- if format.isDescribed and format.isDescribed._value is sameas true %}
                        well described{{ macros.linkQuestion(format.isDescribed._path) }}
                    {%- elif format.isDescribed and format.isDescribed._value is sameas false %}
                        not well described{{ macros.linkQuestion(format.isDescribed._path) }}
                    {%- endif -%}
                    {%- if format.isStandard and format.isStandard._value is sameas true %}
                        standard format{{ macros.linkQuestion(format.isStandard._path) }}
                    {%- elif format.isStandard and format.isStandard._value is sameas false %}
                        {%- if format.noStandardReason -%}
                            {%- if format.noStandardReason._value == "no_format" %}
                                non-standard format. We use it because there is no standardized format for this data type{{ macros.linkQuestion(format.noStandardReason._path) }}
                            {%- elif format.noStandardReason._value == "optimalization" %}
                                non-standard format but it is optimized for processing speed and/or volume{{ macros.linkQuestion(format.noStandardReason._path) }}
                            {%- elif format.noStandardReason and format.noStandardReason._value %}
                                non-standard format. We use it because: {{ format.noStandardReason._value }}{{ macros.linkQuestion(format.noStandardReason._path) }}
                            {%- endif -%}
                        {%- else %}
                            non-standard format{{ macros.linkQuestion(format.isStandard._path) }}
                        {%- endif %}
                    {%- endif -%}
                    .
                {%- endif -%}
                {# Suitable for long term? #}
                {%- if format.isSuitableForLongTerm -%}
                    {%- if format.isSuitableForLongTerm._value is sameas true %}
                        It is suitable for long-term preservation.{{ macros.linkQuestion(format.isSuitableForLongTerm._path) }}
                    {%- elif format.isSuitableForLongTerm._value is sameas false %}
                        It is not suitable for long-term preservation{{ macros.linkQuestion(format.isSuitableForLongTerm._path) }}
                        {# Convert to suitable for long term? #}
                        {%- if format.convertToLongTermSuitable and format.convertToLongTermSuitable._value is sameas true %}
                            and we will convert it to a format suitable for long-term preservation{{ macros.linkQuestion(format.convertToLongTermSuitable._path) }}
                        {%- elif format.convertToLongTermSuitable and format.convertToLongTermSuitable._value is sameas false %}
                            but we will not convert it to a format suitable for long-term preservation{{ macros.linkQuestion(format.convertToLongTermSuitable._path) }}
                        {%- endif -%}.
                    {%- endif -%}
                {%- endif -%}
                </p>
            </li>
            {%- endfor -%}
            </ul>
        </div>
        {%- else -%}
        <div>We will not be using any specific data formats or types.</div>
        {%- endif -%}

        {# Used standards (ontologies, vocabularies, ..) #}
        {%- if usedOntologies|length > 0 -%}
        <div>We will be using the following standards (encodings, terminologies, vocabularies, ontologies):
            <ul>
            {%- for ontology in usedOntologies -%}
                <li>
                    {%- if ontology.name -%}
                        <em>{{ ontology.name._value }}{{ macros.linkQuestion(ontology.name._path) }}</em>
                    {%- else -%}
                        <em>(no name given)</em>
                    {%- endif -%}
                    {%- if ontology.url -%}
                        - <a href="{{ ontology.url._value }}" target="_blank">{{ ontology.url._value }}</a>{{ macros.linkQuestion(ontology.url._path) }}
                    {%- endif -%}
                </li>
            {%- endfor -%}
            </ul>
        </div>
        {%- else -%}
        <div>We will not be using any specific standards (encodings, terminologies, vocabularies, ontologies).</div>
        {%- endif -%}

        {# New data types #}
        {%- if newDataTypes|length > 0 -%}
        <div>For the following distribution list, we will use new types of data as explained below:
            <ul>
            {%- for newDataType in newDataTypes -%}
                <li>
                    <b>{{ newDataType.distributionName._value if newDataType.distributionName else "(no name given)" }}</b>{{ macros.linkQuestion(newDataType.distributionName._path) }}
                    {%- if newDataType.newDataType -%}
                        {%- if newDataType.newDataType.usesNewOntology -%}
                            {%- set usesOntology = newDataType.newDataType.usesNewOntology._value -%}
                        {%- endif -%}
                        {%- if newDataType.newDataType.providesOntologyMapping -%}
                            {%- set providesMapping = newDataType.newDataType.providesOntologyMapping._value -%}
                        {%- endif -%}
                    {%- endif -%}
                    <p>
                    {# Data type registries #}
                    {%- if newDataType.newDataType.dataTypeRegistry and newDataType.newDataType.dataTypeRegistry._value %}
                        We will use the following data type registries: {{ newDataType.newDataType.dataTypeRegistry._value|markdown }}{{ macros.linkQuestion(newDataType.newDataType.dataTypeRegistry._path) }}
                    {%- endif -%}
                    {# Ontology and mapping #}
                    {%- if usesOntology is sameas false %}
                        Although we will be using new types of data, suitable public controlled vocabularies or ontologies exist for those.{{ macros.linkQuestion(newDataType.newDataType.usesNewOntology._path) }}
                    {%- elif usesOntology is sameas true and providesMapping is sameas true %}
                        We will create a completely new and custom data type format. Since we are using new types of data, we will make and publish a vocabulary or ontology for some of our data.{{ macros.linkQuestion(newDataType.newDataType.usesNewOntology._path) }} Such terms will be mapped to existing vocabularies or ontologies.{{ macros.linkQuestion(newDataType.newDataType.providesOntologyMapping._path) }}
                    {%- elif usesOntology is sameas true and providesMapping is sameas false %}
                        We will create a completely new and custom data type format. Since we are using new types of data, we will make and publish a vocabulary or ontology for some of our data.{{ macros.linkQuestion(newDataType.newDataType.usesNewOntology._path) }} We will not provide mapping to existing vocabularies or ontologies.{{ macros.linkQuestion(newDataType.newDataType.providesOntologyMapping._path) }}
                    {%- elif usesOntology is sameas true %}
                        We will create a completely new and custom data type format. Since we are using new types of data, we will make and publish a vocabulary or ontology for some of our data.{{ macros.linkQuestion(newDataType.newDataType.usesNewOntology._path) }}
                    {%- endif -%}
                    {# Fields #}
                    {%- if newDataType.newDataType.needsAddFields -%}
                        {%- if newDataType.newDataType.needsAddFields._value == "no" %}
                            We will not need to add any new fields to the data, all of them are already descried in a data type registry.{{ macros.linkQuestion(newDataType.newDataType.needsAddFields._path) }}
                        {%- elif newDataType.newDataType.needsAddFields._value == "yes_existing_registry" %}
                            We will need to add new types to an existing data type registry.{{ macros.linkQuestion(newDataType.newDataType.needsAddFields._path) }}
                        {%- elif newDataType.newDataType.needsAddFields._value == "yes_own_registry" %}
                            We will need to add new types to data type registry, that we will create on our own.{{ macros.linkQuestion(newDataType.newDataType.needsAddFields._path) }}
                        {%- endif -%}
                    {%- endif -%}
                    {# Creation process #}
                    {%- if newDataType.newDataType.creationProcess -%}
                        {%- if newDataType.newDataType.creationProcess._value == "specification"%}
                            There is a closely related, more generic and open format that we can specialize for our needs.{{ macros.linkQuestion(newDataType.newDataType.creationProcess._path) }}
                        {%- elif newDataType.newDataType.creationProcess._value == "linked_data_format" %}
                            There is a Linked Data Format that we can use to design our new data type.{{ macros.linkQuestion(newDataType.newDataType.creationProcess._path) }}
                        {%- elif newDataType.newDataType.creationProcess._value == "custom" %}
                            We will create a completely new and custom data type format.{{ macros.linkQuestion(newDataType.newDataType.creationProcess._path) }}
                        {%- endif -%}
                    {%- endif -%}
                    {# Description for others #}
                    {%- if newDataType.newDataType.descriptionForOther and newDataType.newDataType.descriptionForOther._value is sameas true %}
                        We will provide a description of the new data type for others.{{ macros.linkQuestion(newDataType.newDataType.descriptionForOther._path) }}
                    {%- endif -%}
                    </p>
                </li>
            {%- endfor -%}
            </ul>
        </div>
        {%- else -%}
        <div>We will not be using any new types of data.</div>
        {%- endif -%}

        {# Qualified references #}
        {%- set ns = namespace(has_qualified_references=false) -%}
        {%- for dataset in data.dmp.datasets -%}
            {%- if dataset.qualifiedReferences|length > 0 -%}
                {%- set ns.has_qualified_references = true -%}
            {%- endif -%}
        {%- endfor -%}
        {%- if ns.has_qualified_references -%}
        <p>The following produced datasets have qualified references:</p>
        <ul>
        {% for dataset in data.dmp.datasets %}
            {%- if dataset.qualifiedReferences|length > 0 -%}
            <li>
                <strong>
                    {% if dataset.name %}
                        {{ dataset.name._value }}{{ macros.linkQuestion(dataset.name._path) }}
                    {% else %}
                        <em>(no name given)</em>
                    {% endif %}
                </strong>
                <ul>
                {%- for reference in dataset.qualifiedReferences -%}
                    <li>
                        <em>
                            {%- if reference.identifier -%}
                                {{ macros.formatIdentifier(reference.identifier) }}{{ macros.linkQuestion(reference.identifier._path) if reference.identifier._path }}
                            {%- endif -%}
                        </em>
                        &ndash;
                        {% if reference.relationship %}
                            {{ reference.relationship._value }}{{ macros.linkQuestion(reference.relationship._path) }}
                        {% else %}
                            <em>(no relationship given)</em>
                        {% endif %}
                    </li>
                {%- endfor -%}
            </ul>
            </li>
            {% endif %}
        {% endfor %}
        </ul>
        {%- endif -%}
    </div>
</div>
