<div id="q-reusable" class="question">
  <div class="answer">

    <p>This section provides details on how the data will be prepared for broad reuse, documentation practices, long-term preservation, data quality assurance, and the inclusion of provenance and methodological information to support validation and future use.</p>
    {# Measure quality - Collection #}
    {%- if data.dmp.sharedResources.collections | length > 0 -%}
        {%- set n = data.dmp.sharedResources.collections | length -%}
        <h4>Quality assurance processes for data collection</h4>
        {% if data.dmp.sharedResources.collections | length > 1 %}
            <p>Within our {{ globals.projects }}, {{ data.dmp.sharedResources.collections | length }} distinct collection processes will be used to gather and generate research data which is connected to applied quality assurance processes:</p>
        {% endif %}
        {%- if n > 1 -%}<ul>{%- endif -%}
        {% for collection in data.dmp.sharedResources.collections %}
            {%- if n > 1 -%}<li style="margin-bottom: 2em;">{%- else -%}<div style="margin-bottom: 2em;">{%- endif -%}
            {{ macros.datasetIntro(collection, "quality assurance process", data.dmp.datasets) }}
            {%- if collection.isEquipmentCollection._value is sameas true -%}
                {% set equipmentCollection = collection.equipmentCollection %}
                {# Quality processes #}
                {% set quality_labels = {
                "calibration": "calibrating measures",
                "repeatSamples": "conducting repeat samples or repeating measurements to monitor consistency",
                "standardizedMethods": "using standardized methods for data capture and recording",
                "dataEntryValidation": "performing data entry validation",
                "dataPeerReview": "applying data peer review",
                "usesControlledVocabularies": "using controlled vocabularies",
                "knownOutcomeSamples": "measuring samples with known outcomes to monitor consistency"
                } %}
                {% set used = [] %}
                {% for key, label in quality_labels.items() %}
                    {% if collection.equipmentCollection.qualityProcesses[key]
                        and collection.equipmentCollection.qualityProcesses[key]._value is sameas true %}
                        {% do used.append(label) %}
                    {% endif %}
                {% endfor %}
                {% if used | length > 0 %}
                <p>
                    As part of this equipment-based collection, the following quality assurance procedures will be implemented:
                    {{ used | join(", ") }}{% if collection.equipmentCollection.qualityProcesses.otherQualityProcesses and collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value %}, {{ collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value }}{% endif %}.
                    {{ macros.linkQuestion(collection.equipmentCollection.usesQualityProcesses._path) }}
                </p>
                {%- else -%}
                    <p>No specific quality assurance procedures have been outlined for this equipment-based collection.{{ macros.linkQuestion(collection.equipmentCollection.usesQualityProcesses._path) }}</p>
                {%- endif -%}
            {%- elif collection.isEquipmentCollection._value is sameas false -%}
                <p>This collection process does not involve the use of measuring equipment thus no quality assurance procedures are applied.{{ macros.linkQuestion(collection.isEquipmentCollection._path) }}</p>
            {%- else -%}
                <p>No information was provided about the use of measuring equipment and related quality assurance procedures in this collection.</p>           
            {%- endif -%}
            {%- if n > 1 -%}</li>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}
        {%- if n > 1 -%}</ul>{%- endif -%}
    {%- endif -%}

    {# Validating the integrity of the results #}
    {%- if data.dmp.sharedResources.processingEnvironments | length > 0 -%}
        {%- set n = data.dmp.sharedResources.processingEnvironments | length -%}
        <h4>Validation of Data Integrity in Processing Environments</h4>
        {%- set envMonitoring = [] -%}
        {%- for env in data.dmp.sharedResources.processingEnvironments -%}
            {%- if env.isMonitoringIntegrityAfterProcessing._value is sameas true and env.monitoringIntegrityAfterProcessing | length > 0 -%}
                {%- do envMonitoring.append(env) -%}
            {%- endif -%}
        {%- endfor -%}
        {% if envMonitoring | length > 1 %}
            <p>Within {{ globals.projects }}, multiple validation processes will be applied to ensure the integrity and reliability of the research results.</p>
        {% endif %}
        {%- if n > 1-%}<ul>{%- endif -%}
        {% for env in envMonitoring %}
            {%- if n > 1 -%}<li style="margin-bottom: 2em;">{%- else -%}<div style="margin-bottom: 2em;">{%- endif -%}
                {{ macros.datasetIntro(env, "process for validating data integrity", data.dmp.datasets) }}
                <p>
                    The validation procedures implemented within this processing environment include: 
                    {{ env.monitoringIntegrityAfterProcessing | map(attribute='_label') | map('lower') | join(", ") }}.{{ macros.linkQuestion(env.isMonitoringIntegrityAfterProcessing._path) }}
                </p>
            {%- if n > 1 -%}</li>{%- else -%}</div>{%- endif -%}
        {% endfor %}
        {%- if n > 1 -%}</ul>{%- endif -%}
    {% endif %}
    
    {# Reuse restrictions #}
    {%- if data.dmp.sharedResources.reuseRestrictions | length > 0 -%}
        {%- set n = data.dmp.sharedResources.reuseRestrictions | length -%}
        <h4>Reuse Restrictions, Ownership and Openness of the Data</h4>
        {%- if data.dmp.sharedResources.reuseRestrictions | length > 1 -%}
            <p>In our {{ globals.projects }}, there are {{ data.dmp.sharedResources.reuseRestrictions | length }} approaches towards access conditions, ownership and openness of the data, as described below:</p>
        {%- endif -%}
        {%- if n > 1 -%}<ul>{%- endif -%}
        {%- for reuseRestriction in data.dmp.sharedResources.reuseRestrictions -%}
            {%- if n > 1 -%}<li style="margin-bottom: 2em;">{%- else -%}<div style="margin-bottom: 2em;">{%- endif -%}
            {{ macros.datasetIntro(reuseRestriction, "on access conditions, ownership and openness of the data", data.dmp.datasets) }}
            {% set numDatasets = reuseRestriction.usedBy | length %}

            {# Can open data #}
            {%- if reuseRestriction.accessRestriction.canDataOpen._value is sameas true -%}
                <p>As described in Section 2.2, the data may become completely open over time.{{ macros.linkQuestion(reuseRestriction.accessRestriction.canDataOpen._path) }}</p>
            {%- elif reuseRestriction.accessRestriction.canDataOpen._value is sameas false -%}
                <p>As described in Section 2.2, the data cannot be made completely open.{{ macros.linkQuestion(reuseRestriction.accessRestriction.canDataOpen._path) }}</p>
                {%- set dataCannotOpen = reuseRestriction.accessRestriction.dataCannotOpen -%}
                {%- if dataCannotOpen.isLegalReason._value is sameas true -%}
                    {%- if dataCannotOpen.legalReason.isPrivacyReason._value is sameas true -%}
                    <p>
                        {%- if dataCannotOpen.legalReason.privacyReason.locationOfData._value == "no" %}
                            There are no location-based storage restrictions arising from privacy considerations.{{ macros.linkQuestion(dataCannotOpen.legalReason.privacyReason.locationOfData._path) }}
                        {%- elif dataCannotOpen.legalReason.privacyReason.locationOfData._value == "eu" %}
                            Due to privacy considerations, the data must be stored within the European Union.{{ macros.linkQuestion(dataCannotOpen.legalReason.privacyReason.locationOfData._path) }}
                        {%- elif dataCannotOpen.legalReason.privacyReason.locationOfData._value == "country" %}
                            Due to privacy considerations, the data must remain within the country of origin.{{ macros.linkQuestion(dataCannotOpen.legalReason.privacyReason.locationOfData._path) }}
                        {%- elif dataCannotOpen.legalReason.privacyReason.locationOfData._value == "institute" %}
                            Due to privacy considerations, the data must remain within the hosting institution.{{ macros.linkQuestion(dataCannotOpen.legalReason.privacyReason.locationOfData._path) }}
                        {%- endif -%}

                        {%- set privacyCanUse = [] -%}
                        {%- set privacyCannotUse = [] -%}
                        {%- set privacyReason = dataCannotOpen.legalReason.privacyReason -%}
                        {%- if privacyReason.howToMoreOpen.pseudonymization._value is sameas false -%}
                            {%- do privacyCannotUse.append("pseudonymization") -%}
                        {%- elif privacyReason.howToMoreOpen.pseudonymization._value is sameas true -%}
                            {%- do privacyCanUse.append("pseudonymization") -%}
                        {%- endif -%}
                        {%- if privacyReason.howToMoreOpen.anonymization._value is sameas false -%}
                            {%- do privacyCannotUse.append("anonymization") -%}
                        {%- elif privacyReason.howToMoreOpen.anonymization._value is sameas true -%}
                            {%- do privacyCanUse.append("anonymization") -%}
                        {%- endif -%}
                        {%- if privacyReason.howToMoreOpen.aggregation._value is sameas false -%}
                            {%- do privacyCannotUse.append("data aggregation") -%}
                        {%- elif privacyReason.howToMoreOpen.aggregation._value is sameas true -%}
                            {%- do privacyCanUse.append("data aggregation") -%}
                        {%- endif -%}

                        {%- if privacyCanUse|length == 1 %}
                            We can use {{privacyCanUse[0]}} to make the data more openly available.
                        {%- elif privacyCanUse|length == 2 %}
                            We can use {{privacyCanUse[0]}} and {{privacyCanUse[1]}} to make the data more openly available.
                        {%- elif privacyCanUse|length == 3 %}
                            We can use {{privacyCanUse[0]}}, {{privacyCanUse[1]}}, and {{privacyCanUse[2]}} to make the data more openly available.
                        {%- endif -%}

                        {%- set privacyCannotUseStart = "We cannot use" if privacyCanUse|length == 0 else "But we cannot use" -%}
                        {%- if privacyCannotUse|length == 1 %}
                            {{privacyCannotUseStart}} {{privacyCannotUse[0]}} to make the data more openly available.
                        {%- elif privacyCannotUse|length == 2 %}
                            {{privacyCannotUseStart}} neither {{privacyCannotUse[0]}} nor {{privacyCannotUse[1]}} to make the data more openly available.
                        {%- elif privacyCannotUse|length == 3 %}
                            {{privacyCannotUseStart}} neither {{privacyCannotUse[0]}} nor {{privacyCannotUse[1]}}, nor {{privacyCannotUse[2]}} to make the data more openly available.
                        {%- endif -%}

                        {%- if privacyReason.howToMoreOpen.pseudonymization._value is sameas true -%}
                            {%- if privacyReason.howToMoreOpen.useThirdPartyForPseudonymization._value is sameas false %}
                                For pseudonymization purposes, no trusted third party will be engaged.{{ macros.linkQuestion(privacyReason.howToMoreOpen.useThirdPartyForPseudonymization._path) }}
                            {%- elif privacyReason.howToMoreOpen.useThirdPartyForPseudonymization._value is sameas true %}
                                For pseudonymization purposes, a trusted third party may be engaged.{{ macros.linkQuestion(privacyReason.howToMoreOpen.useThirdPartyForPseudonymization._path) }}
                            {%- endif -%}
                        {%- endif -%}
                    </p>
                    {%- endif -%}

                    {# Access to private data - leave out, complete access is described in Section 2.2 #}
                    {%- if dataCannotOpen.legalReason.isAuthenticatedAccess._value is sameas true -%}
                        <p>The procedure governing authorized access to the data is described in Section 2.2.{{ macros.linkQuestion(dataCannotOpen.legalReason.isAuthenticatedAccess._path) }}</p>
                    {%- endif -%}

                    {# Intellectual Property #}
                    {%- if dataCannotOpen.legalReason.isIntellectualPropertyReason._value is sameas true -%}
                    <p>
                        {%- set intellectualPropertyReason = dataCannotOpen.legalReason.intellectualPropertyReason %}
                        There are intellectual property reasons why our data cannot be open.{{ macros.linkQuestion(dataCannotOpen.legalReason.isIntellectualPropertyReason._path) }}
                        {%- if intellectualPropertyReason.isOwnershipOfDataDefined._value is sameas true %}
                            It is clear who owns data and documents.{{ macros.linkQuestion(intellectualPropertyReason.isOwnershipOfDataDefined._path) }}
                        {%- endif -%}
                        {%- if intellectualPropertyReason.isDecisionPowerOfMovingDataDefined._value is sameas true %}
                            Someone will be given the decision power to move documents or data to a new place after the {{globals.projects}} has finished.{{ macros.linkQuestion(intellectualPropertyReason.isDecisionPowerOfMovingDataDefined._path) }}
                        {%- endif -%}
                    </p>
                    {%- elif  dataCannotOpen.legalReason.isIntellectualPropertyReason._value is sameas false %}
                        <p>There are no intellectual property reasons why our data cannot be open.{{ macros.linkQuestion(dataCannotOpen.legalReason.isIntellectualPropertyReason._path) }}</p>
                    {%- endif -%}
                {%- endif -%}
            {%- else -%}
                <p>No information has been provided regarding data access conditions, ownership, or openness.</p>
            {%- endif -%}
            {%- if n > 1 -%}</li>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}
        {%- if n > 1 -%}</ul>{%- endif -%}
    {%- endif -%}

    {# Cold storage - preservation strategy #}
    {%- if data.dmp.sharedResources.preservationStrategies|length > 0 -%}
        {%- set n = data.dmp.sharedResources.preservationStrategies | length -%}
        <h4>Long-term Preservation of the Data</h4>
        {%- if data.dmp.sharedResources.preservationStrategies|length > 1 -%}
            <p>Within {{ globals.projects }}, there are {{ data.dmp.sharedResources.preservationStrategies | length }} approaches towards long-term data preservation.</p>
        {%- endif -%}
      {%- if n > 1 -%}<ul>{%- endif -%}
        {%- for preservationStrategy in data.dmp.sharedResources.preservationStrategies -%}
            {%- if n > 1 -%}<li style="margin-bottom: 2em;">{%- else -%}<div style="margin-bottom: 2em;">{%- endif -%}

            {{ macros.datasetIntro(preservationStrategy, "long-term preservation", data.dmp.datasets) }}
            {% set numDatasets = preservationStrategy.usedBy | length %}
            {%- set accessRestriction = preservationStrategy.accessRestriction -%}

            {%- if preservationStrategy.usesLongTermStorageDuringProject._value is sameas true and preservationStrategy.usesLongTermStorageAfterProject._value is sameas true %}
            We will be archiving data (using so-called 'cold storage') for long term preservation after the {{globals.projects}}{{ macros.linkQuestion(preservationStrategy.usesLongTermStorageAfterProject._path) }} but also already during the {{globals.projects}}.{{ macros.linkQuestion(preservationStrategy.usesLongTermStorageDuringProject._path) }}
            {%- elif preservationStrategy.usesLongTermStorageDuringProject._value is sameas true %}
            We will be archiving data (using so-called 'cold storage') for long term preservation already during the {{globals.projects}}.{{ macros.linkQuestion(preservationStrategy.usesLongTermStorageDuringProject._path) }}
            {%- elif preservationStrategy.usesLongTermStorageAfterProject._value is sameas true %}
            We will be archiving data (using so-called 'cold storage') for long term preservation after the {{globals.projects}}.{{ macros.linkQuestion(preservationStrategy.usesLongTermStorageAfterProject._path) }}
            {%- elif preservationStrategy.usesLongTermStorageAfterProject._value is sameas false  and preservationStrategy.usesLongTermStorageDuringProject._value is sameas false %}
            We will not be archiving data (using so-called 'cold storage') for long term preservation during or after the {{globals.projects}}.{{ macros.linkQuestion(preservationStrategy.usesLongTermStorageAfterProject._path) }}
            {%- elif preservationStrategy.usesLongTermStorageDuringProject._value is sameas false -%}
            We will not be archiving data (using so-called 'cold storage') for long term preservation during the {{globals.projects}}.{{ macros.linkQuestion(preservationStrategy.usesLongTermStorageDuringProject._path) }}
            {%- elif preservationStrategy.usesLongTermStorageAfterProject._value is sameas false -%}
            We will not be archiving data (using so-called 'cold storage') for long term preservation after the {{globals.projects}}.{{ macros.linkQuestion(preservationStrategy.usesLongTermStorageAfterProject._path) }}
            {%- endif -%}

            {# How long will data be preserved during project? #}
            {%- if preservationStrategy.usesLongTermStorageDuringProject._value is sameas true -%}
            {% set period = preservationStrategy.longTermStorageDuringProject.archivePeriod %}
                {% if period._value %}
                    {% if period._value == "as_long_as_possible" %}
                        This data will be retained during {{ globals.projects }} for as long as technically feasible.
                    {% elif period._value == "until_needs_delete" %}
                        This data will be retained during {{ globals.projects }} until deletion is required due to legal, contractual, or regulatory constraints.
                    {% else %}
                        This data will be retained during {{ globals.projects }} for a fixed period of {{ period._value }}.
                    {% endif %}
                        {{ macros.linkQuestion(period._path) }}
                {% endif %}
            {%- endif -%}

            {%- if preservationStrategy.usesLongTermStorageAfterProject._value is sameas true -%}
                {%- if preservationStrategy.longTermStorageAfterProject -%}
                    {%- set longTermStorageAfterProject = preservationStrategy.longTermStorageAfterProject -%}

                    {# Lifetime #}
                    {%- if longTermStorageAfterProject.minimumLifeTimeYears._value == "5" %}
                        The minimum lifetime of the archive is 5 years.{{ macros.linkQuestion(longTermStorageAfterProject.minimumLifeTimeYears._path) }}
                    {%- elif longTermStorageAfterProject.minimumLifeTimeYears._value == "10" %}
                        The minimum lifetime of the archive is 10 years.{{ macros.linkQuestion(longTermStorageAfterProject.minimumLifeTimeYears._path) }}
                    {%- elif longTermStorageAfterProject.minimumLifeTimeYears._value == "15" %}
                        The minimum lifetime of the archive is 15 years.{{ macros.linkQuestion(longTermStorageAfterProject.minimumLifeTimeYears._path) }}
                    {%- elif longTermStorageAfterProject.minimumLifeTimeYears._value -%}
                        {%- set end = " year." if (longTermStorageAfterProject.minimumLifeTimeYears._value == "1") else " years." %}
                        The minimum lifetime of the archive is {{longTermStorageAfterProject.minimumLifeTimeYears._value}} {{end}}{{ macros.linkQuestion(longTermStorageAfterProject.minimumLifeTimeYears._path) }}
                    {%- elif longTermStorageAfterProject.minimumLifeTimeOther._value  %}
                        The minimum lifetime of the archive is specially arranged {{longTermStorageAfterProject.minimumLifeTimeOther._value}}. {{ macros.linkQuestion(longTermStorageAfterProject.minimumLifeTimeOther._path) }}
                    {%- endif -%}
                {%- endif -%}
            {%- endif -%}
        {%- if n > 1 -%}</li>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}
      {%- if n > 1 -%}</ul>{%- endif -%}
    {%- else -%}
      <p>No long-term storage solutions have been defined for this project. Therefore, there is no harmonised approach towards long-term data preservation to report.</p>
    {%- endif -%}
        
    {# Documentation Specifications #}
    {% if data.dmp.sharedResources.documentationSpecifications | length > 0 %}
        {%- set n = data.dmp.sharedResources.documentationSpecifications | length -%}
        <h4>Documentation Specifications</h4>
        {% if data.dmp.sharedResources.documentationSpecifications | length > 1 %}
            <p>In our {{ globals.projects }}, {{ data.dmp.sharedResources.documentationSpecifications | length }} different approaches to documentation will be applied to ensure the completeness, clarity, and discoverability of research outputs.</p>
        {% endif %}
        {%- if n > 1 -%}<ul>{%- endif -%}
        {% for documentation in data.dmp.sharedResources.documentationSpecifications %}
            {%- if n > 1 -%}<li style="margin-bottom: 1.5em;">{%- else -%}<div style="margin-bottom: 1.5em;">{%- endif -%}

            {{ macros.datasetIntro(documentation, "documentation approach", data.dmp.datasets) }}

            {# Description #}
            {% if documentation.description._value %}
                <p>
                This documentation approach will cover: {{ documentation.description._value | e }}.
                {{ macros.linkQuestion(documentation.description._path) }}
                </p>
            {% endif %}

            {# Additional included items #}
            {% set included_items = [] %}
            {% if documentation.includeMethodology._value is sameas true %}
                {% do included_items.append("methodological aspects of data collection") %}
            {% endif %}
            {% if documentation.includeDataValidation._value is sameas true %}
                {% do included_items.append("information on data validation procedures") %}
            {% endif %}

            {% if included_items | length > 0 %}
                <p>
                The documentation will include {{ included_items | join(" and ") }}{% if documentation.description._value %} to provide sufficient context{% endif %}.
                </p>
            {% endif %}

            {# Format #}
            {% if documentation.format._value %}
                <p>
                The documentation will be available in the following format:
                <em>{{ documentation.format._value | e }}</em>.
                {{ macros.linkQuestion(documentation.format._path) }}
                </p>
            {% endif %}
            {%- if n > 1 -%}</li>{%- else -%}</div>{%- endif -%}
        {% endfor %}
        {%- if n > 1 -%}</ul>{%- endif -%}
    {% endif %}

    {# Provenance #}
    {%- if data.dmp.sharedResources.metadataSpecifications | length > 0 -%}
        {%- set n = data.dmp.sharedResources.metadataSpecifications | length -%}
        <h4>Provenance Documentation</h4>
        {% if data.dmp.sharedResources.metadataSpecifications | length > 1 %}
            <p>To document the provenance of the generated data in our {{ globals.projects }}, several approaches will be employed:</p>
        {% endif %}
        {%- if n > 1 -%}<ul>{%- endif -%}
        {% for metadata in data.dmp.sharedResources.metadataSpecifications %}
            {%- if n > 1 -%}<li style="margin-bottom: 2em;">{%- else -%}<div style="margin-bottom: 2em;">{%- endif -%}
            {{ macros.datasetIntro(metadata, "specification for documenting data provenance", data.dmp.datasets) }}
            <p>
            {%- if metadata.isProvenanceDocumented._value is sameas true -%}
                {%- if metadata.provenanceDocumented.provenanceDocumentedType -%}
                    {%- if metadata.provenanceDocumented.provenanceDocumentedType._value == "lab_notebook" -%}
                        We will use lab notebooks to make sure that there is good provenance of the data analysis.
                    {%- elif metadata.provenanceDocumented.provenanceDocumentedType._value == "electronic_lab_notebook" -%}
                        We will use an electronic lab notebook to make sure that there is good provenance of the data analysis.
                    {%- elif metadata.provenanceDocumented.provenanceDocumentedType._value == "system" -%}
                        Our computing workflow system keeps provenance information to ensure the good provenance of the data analysis.
                    {%- elif metadata.provenanceDocumented.provenanceDocumentedType -%}
                        We will use other solution than (electronic) lab notebooks to make sure that there is good provenance of the data analysis{{ ": " ~ metadata.provenanceDocumented.provenanceDocumentedType._value }}
                    {%- endif -%}
                    {{ macros.linkQuestion(metadata.provenanceDocumented.provenanceDocumentedType._path) }}
                {%- endif -%}

                {%- if metadata.provenanceDocumented.usesStandard._value is sameas true -%}
                    {%- if metadata.provenanceDocumented.standardProvenanceUsed %}
                        For documenting the provenance, we will use the following standard: <em>{{ metadata.provenanceDocumented.standardProvenanceUsed._value }}</em>.{{ macros.linkQuestion(metadata.provenanceDocumented.standardProvenanceUsed._path) }}
                    {%- else %}
                        For documenting provenance we will use a standard (no specific standard has been provided).{{ macros.linkQuestion(metadata.provenanceDocumented.usesStandard._path) }}
                    {%- endif -%}

                {%- elif metadata.provenanceDocumented.usesStandard._value is sameas false -%}
                    {%- if metadata.provenanceDocumented.noStandardReason._value == "no_standard" %}
                        For documenting provenance we will not use a standard because there is no standard in our {{globals.project}} area.{{ macros.linkQuestion(metadata.provenanceDocumented.noStandardReason._path) }}
                    {%- elif metadata.provenanceDocumented.noStandardReason._value %}
                        For documenting provenance we will not use a standard because: {{ metadata.provenanceDocumented.noStandardReason._value }}.{{ macros.linkQuestion(metadata.provenanceDocumented.noStandardReason._path) }}
                    {%- else %}
                        We will not use a standard for documenting provenance.{{ macros.linkQuestion(metadata.provenanceDocumented.usesStandard._path) }}
                    {%- endif -%}

                {%- endif -%}

            {%- elif metadata.isProvenanceDocumented._value is sameas false -%}
                Provenance is not documented{%- if metadata.noProvenanceReason %} because: {{ metadata.noProvenanceReason._value }}{{ macros.linkQuestion(metadata.noProvenanceReason._path) }}{%- else -%}.{{ macros.linkQuestion(metadata.isProvenanceDocumented._path) }}{%- endif -%}
            {%- else -%}
                No information has been provided about whether provenance will be documented.
            {%- endif -%}
            </p>

            {%- if metadata.isAvailableAfterDataNotAvailable._value is sameas true %}
                <p>Metadata will be available even after the data is no longer available{{ macros.linkQuestion(metadata.isAvailableAfterDataNotAvailable._path) }}
                {%- if metadata.howAvailableGuaranteed._value %}
                (we will do the following: {{ metadata.howAvailableGuaranteed._value }}){{ macros.linkQuestion(metadata.howAvailableGuaranteed._path) }}</p>
                {%- endif -%}
            {%- elif metadata.isAvailableAfterDataNotAvailable._value is sameas false %}
                <p>Metadata will <strong>not</strong> be available after the data is no longer available{{ macros.linkQuestion(metadata.isAvailableAfterDataNotAvailable._path) }}
                {%- if metadata.noAvailableReason._value %}
                    (because: {{ metadata.noAvailableReason._value }}){{ macros.linkQuestion(metadata.noAvailableReason._path) }}
                {%- endif -%}</p>
            {%- endif -%}
            {%- if n > 1 -%}</li>{%- else -%}</div>{%- endif -%}
        {% endfor %}
        {%- if n > 1 -%}</ul>{%- endif -%}

    {%- else -%}
        <p>No specification for documenting the provenance of the generated data has been defined.</p>
    {%- endif -%}
  </div>
</div>
