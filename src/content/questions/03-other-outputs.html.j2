<div id="q-other-outputs" class="question">
  <div class="answer">
    <p>We use the <a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_name }}</a> for planning our data management and creating this DMP. The management and planning of other research outputs is done separately and is included in this Section. Still, we benefit from data stewardship guidance (e.g. FAIR principles, openness, or security) and it is reflected in our plans with respect to other research outputs.</p>

    {%- if data.dmp.outputsRetentionCriteriaDescription is not none -%}
        <p>We decide which additional research outputs should be retained as follows: {{ data.dmp.outputsRetentionCriteriaDescription._value|dot }}{{ macros.linkQuestion(data.dmp.outputsRetentionCriteriaDescription._path) }}</p>
    {%- endif -%}

    {%- if data.dmp.areOtherOutputs and data.dmp.areOtherOutputs._value is sameas true -%}

        {%- if data.dmp.swPackages|length > 0 -%}
            <p>We plan to produce the following software package{{ "s" if data.dmp.swPackages|length > 1 else "" }} as additional research output{{ "s" if data.dmp.swPackages|length > 1 else "" }}:</p>
            <ul>
            {%- for swPackage in data.dmp.swPackages -%}
                <li>
                {%- if swPackage.name -%}
                    <em>{{ swPackage.name._value }}{{ macros.linkQuestion(swPackage.name._path) }}:</em>
                {%- else -%}
                    <em>Unnamed software package:</em>
                {%- endif -%}
                <br>
                {%- if swPackage.isOpenLicense -%}
                    {%- if swPackage.isOpenLicense._value is sameas true -%}
                        This software package will be released under an open-source license
                        {%- if swPackage.openSourceLicense -%}
                            {%- if swPackage.openSourceLicense._raw %} <em><a href="{{ swPackage.openSourceLicense._raw.url }}" target="_blank">{{ swPackage.openSourceLicense._raw.name }}</a>{{ macros.linkQuestion(swPackage.openSourceLicense._path) }}</em>
                            {%- else %} <em>{{ swPackage.openSourceLicense._value }}{{ macros.linkQuestion(swPackage.openSourceLicense._path) }}</em>
                            {% endif -%}.
                        {%- else %} (specific license not given).
                        {%- endif -%}
                    {%- elif swPackage.isOpenLicense._value is sameas false -%}
                        This software package will not be released under an open-source license.
                    {%- endif -%}
                {%- endif -%}
                {%- if swPackage.whereAvailable %}
                    This software package will be available at: {{ swPackage.whereAvailable._value }}{{ macros.linkQuestion(swPackage.whereAvailable._path) }}
                    {%- if swPackage.isListedInCatalogue -%}
                        {%- if swPackage.isListedInCatalogue._value is sameas true %}
                            and will be listed in a software catalogue.{{ macros.linkQuestion(swPackage.isListedInCatalogue._path) }}
                        {%- elif swPackage.isListedInCatalogue._value is sameas false %}
                            and will not be listed in a software catalogue.{{ macros.linkQuestion(swPackage.isListedInCatalogue._path) }}
                        {%- endif -%}
                    {%- endif -%}
                {%- else -%}
                    {%- if swPackage.isListedInCatalogue -%}
                        {%- if swPackage.isListedInCatalogue._value is sameas true %}
                            This software package will be listed in a software catalogue.{{ macros.linkQuestion(swPackage.isListedInCatalogue._path) }}
                        {%- elif swPackage.isListedInCatalogue._value is sameas false %}
                            This software package will not be listed in a software catalogue.{{ macros.linkQuestion(swPackage.isListedInCatalogue._path) }}
                        {%- endif -%}
                    {%- endif -%}
                {%- endif -%}
                </li>
            {%- endfor -%}
            </ul>
        {%- endif -%}

        {%- if data.dmp.otherOutputs|length > 0 -%}
            <p>There are additional research output{{ "s" if data.dmp.otherOutputs|length > 1 else "" }} beyond those already described above:</p>
            <ul>
                {%- for output in data.dmp.otherOutputs -%}
                    <li>
                        {%- if output.description -%}
                            <em>{{ output.description._value }}</em>{{ macros.linkQuestion(output.description._path) }}
                        {%- else -%}
                            <em>Unnamed output</em>
                        {%- endif -%}
                        {%- if output.whyImportant -%}
                            <br>This output is important because: {{ output.whyImportant._value|markdown }}{{ macros.linkQuestion(output.whyImportant._path) }}
                        {% endif %}
                        {%- if output.whoWillUse -%} 
                            <br>Intended users: {{ output.whoWillUse._value|markdown }}{{ macros.linkQuestion(output.whoWillUse._path) }}
                        {% endif %}
                        {%- if output.isAvailable is not none -%}
                            {% if output.isAvailable._value is sameas true %}
                                <br>This output will be available{% if output.whereAvailable %} ({{ output.whereAvailable._value }}).{{ macros.linkQuestion(output.whereAvailable._path) }}{%- else -%}.{{ macros.linkQuestion(output.isAvailable._path) }}{% endif %}
                            {%- elif output.isAvailable._value is sameas false  -%}
                                <br>This output will not be available{% if output.noAvailableReason %} (because: {{ output.noAvailableReason._value }}).{{ macros.linkQuestion(output.noAvailableReason._path) }}{%- else -%}.{{ macros.linkQuestion(output.isAvailable._path) }}{% endif %}
                            {%- endif -%}
                        {%- endif -%}
                    </li>
                {%- endfor -%}
            </ul>
        {%- endif -%}
    {%- elif data.dmp.areOtherOutputs and data.dmp.areOtherOutputs._value is sameas false -%}
        <p>We do not plan to produce any additional research outputs beyond the datasets already described in this DMP.</p>
    {%- endif -%}
  </div>
</div>
